DEPLOYMENT_TARGET_IOS = '15.0'
source 'https://github.com/regulaforensics/podspecs.git'

platform :ios, DEPLOYMENT_TARGET_IOS

target 'FaceSwiftUI-sample' do
  # Comment the next line if you don't want to use dynamic frameworks
  use_frameworks!

  # Pods for FaceSwiftUI-sample
  pod 'FaceSDK', '~> 8.4.0'
  pod 'FaceCoreBasic', '~> 8.4.0'
end

post_install do |installer|
  desired_ios = Gem::Version.new(DEPLOYMENT_TARGET_IOS)

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      settings = config.build_settings
      actual = Gem::Version.new(settings['IPHONEOS_DEPLOYMENT_TARGET'] || '0')
      settings['IPHONEOS_DEPLOYMENT_TARGET'] = DEPLOYMENT_TARGET_IOS if actual < desired_ios
    end
  end
end
